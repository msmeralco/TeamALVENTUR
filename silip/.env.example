# Copy to .env (git-ignored) for local dev. Neon URLs are read from ../env/env.dev
# (DATABASE_POOLER_URL, DATABASE_DIRECT_URL); never put them in this file.

# Local only: every request is a dev user in both groups. Refused inside Lambda.
AUTH_DISABLED=true

# Where readings come from: simulated | clamp | smart_meter
DATA_SOURCE=simulated
DATA_DIR=data/sim

# Strategies (baselines shown). Alternatives: lightgbm, lightgbm, dbscan, quantile_lgbm
FORECASTER=seasonal_naive
RISK_SCORER=rules
OUTAGE_LOCATOR=nearest_report
ETA_ESTIMATOR=median_by_cause

# Simulator only. Deployed salts come from Secrets Manager.
SILIP_SIN_SALT=dev-salt-change-me

# Cognito (when AUTH_DISABLED is false): values from terraform output
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
