# API and ingest Lambdas share this image; Terraform sets the handler per function.
# Build from the silip/ root:  docker build --platform linux/arm64 -f api/Dockerfile.lambda -t silip-api .
FROM public.ecr.aws/lambda/python:3.12

COPY --from=ghcr.io/astral-sh/uv:0.7.3 /uv /usr/local/bin/uv

WORKDIR /build
COPY pyproject.toml uv.lock ./
COPY ml ml
COPY api api

# Locked third-party dependencies, then the two workspace packages, into the task root.
RUN uv export --frozen --no-dev --no-emit-workspace --package silip-api -o requirements.txt \
 && uv pip install --system --target "${LAMBDA_TASK_ROOT}" -r requirements.txt \
 && uv pip install --system --target "${LAMBDA_TASK_ROOT}" --no-deps ./ml ./api \
 && rm -rf /build

WORKDIR ${LAMBDA_TASK_ROOT}
CMD ["silip.app.handler"]
