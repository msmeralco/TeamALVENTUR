# Copy to .env.local. No secrets belong in VITE_* variables: they ship to the browser.
# dev = fake signed-in user in both groups; pair with the API's AUTH_DISABLED=true.
VITE_AUTH_MODE=dev
# For VITE_AUTH_MODE=cognito (values from `terraform output`):
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
