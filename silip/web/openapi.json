              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "description": "Who is signed in.",
        "operationId": "me_api_v1_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Signed in, but not in the required group"
          }
        },
        "security": [
          {
            "CognitoAccessTokenHeader": []
          },
          {
            "CognitoAccessToken": []
          }
        ]
      }
    },
    "/api/v1/transformers": {
      "get": {
        "tags": [
          "transformers"
        ],
        "summary": "List Transformers",
        "description": "Risk tier, reasons and confidence per transformer, Critical first.",
        "operationId": "list_transformers_api_v1_transformers_get",
        "security": [
          {
            "CognitoAccessTokenHeader": []
          },
          {
            "CognitoAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "min_lon,min_lat,max_lon,max_lat",
              "title": "Bbox"
            },
            "description": "min_lon,min_lat,max_lon,max_lat"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransformerRisk"
                  },
                  "title": "Response List Transformers Api V1 Transformers Get"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Signed in, but not in the required group"
          },
          "503": {
            "description": "No completed scoring run yet"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
