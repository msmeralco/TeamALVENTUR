    "/api/v1/outages": {
      "get": {
        "tags": [
          "outages"
        ],
        "summary": "List Outages",
        "description": "Public: outages by area with a restoration range. No household or exact pin data.",
        "operationId": "list_outages_api_v1_outages_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "open",
                    "restored"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "open",
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OutageSummary"
